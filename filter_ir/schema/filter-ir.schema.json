{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Konwerter Okapi Filter IR",
  "type": "object",
  "required": [
    "name",
    "version",
    "mime_types",
    "extensions",
    "features"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "mime_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\."
      },
      "minItems": 1
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parameter_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value_type",
          "default"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value_type": {
            "enum": [
              "boolean",
              "string",
              "integer",
              "pattern"
            ]
          },
          "default": {}
        }
      }
    },
    "token_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "token_type",
          "code_type",
          "tag_strategy",
          "translatable"
        ],
        "properties": {
          "token_type": {
            "type": "string"
          },
          "code_type": {
            "type": "string"
          },
          "tag_strategy": {
            "enum": [
              "isolated",
              "paired",
              "document_part",
              "text"
            ]
          },
          "translatable": {
            "type": "boolean"
          }
        }
      }
    }
  }
}